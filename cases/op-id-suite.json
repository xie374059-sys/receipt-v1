      "expected": "REJECT",
      "receipt": {
        "op_id": "YJ-3cdc-0483",
        "status": "completed",
        "attempts": [
          {
            "attempt": 1,
            "op_id": "YJ-3cdc-0483",
            "status": "completed"
          }
